DATABASE_URI=postgres://USER@localhost:5432/live_conferences_payload
# Signs the auth tokens — the app refuses to boot without it.
PAYLOAD_SECRET=generate-a-random-string
# This app's own origin. Upload urls are built from it, so the value ends up in
# the built HTML — it has to be the origin the Gulp bridge fetches (PAYLOAD_URL
# on the site side). Defaults to http://localhost:3100.
PAYLOAD_URL=
# Browser origins allowed to call the API (comma separated). The Gulp build
# fetches server side and needs none of them.
PAYLOAD_CORS_ORIGINS=
# Schema sync: on in dev, off in production (deploys run `pnpm migrate`).
# Set to 0 locally to test the migration path.
PAYLOAD_DB_PUSH=
